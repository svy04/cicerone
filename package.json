{
  "name": "cicerone",
  "version": "1.28.0",
  "description": "한국 채용 공고를 평가하고 지원 서류를 준비하는 명령줄 도구. 인공지능 코딩 CLI 안에서 돌아갑니다 (Claude Code, Codex, OpenCode, Antigravity, Grok, Qwen, Kimi, Copilot)",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "doctor": "node doctor.mjs",
    "or": "node openrouter-runner.mjs",
    "or:scan": "node openrouter-runner.mjs scan",
    "or:pipeline": "node openrouter-runner.mjs pipeline",
    "or:eval": "node openrouter-runner.mjs evaluate",
    "or:apply": "node openrouter-runner.mjs apply",
    "verify": "node verify-pipeline.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "reconcile": "node reconcile-pipeline.mjs",
    "pdf": "node generate-pdf.mjs",
    "jd:similarity": "node jd-similarity.mjs",
    "img-to-pdf": "node img-to-pdf.mjs",
    "cover-letter": "node generate-cover-letter.mjs --payload",
    "cv:verify-facts": "node verify-cv-facts.mjs",
    "test:cv-visual": "playwright test --config=playwright.cv.config.mjs",
    "test:cv-visual:update": "playwright test --config=playwright.cv.config.mjs --update-snapshots",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node updater-migration-tests.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "extract": "node browser-extract.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "scan:seeds": "node scan-ats-full.mjs --seeds yc,a16z",
    "scan:yc": "node scan-ats-full.mjs --seeds yc",
    "scan:interamt": "node scan-interamt.mjs",
    "company:funded": "node company-funded.mjs",
    "validate:portals": "node validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
    "find": "node find.mjs",
    "patterns": "node analyze-patterns.mjs",
    "upskill": "node upskill.mjs",
    "add": "node add-entry.mjs",
    "reposts": "node detect-reposts.mjs",
    "digest": "node weekly-digest.mjs",
    "freshness": "node check-table-freshness.mjs",
    "rejection-latency": "node rejection-latency.mjs",
    "invite-match": "node invite-match.mjs",
    "paste-reply": "node paste-reply.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "ollama:eval": "node ollama-eval.mjs",
    "openai:eval": "node openai-eval.mjs",
    "openai:tailor": "node openai-tailor.mjs",
    "eval:golden": "node eval-golden.mjs",
    "star": "node match-star.mjs",
    "archive": "node archive-posting.mjs",
    "prepare:application": "node prepare-application.mjs",
    "application:init": "node application-artifacts.mjs --init",
    "build:dashboard": "node build-dashboard.mjs",
    "serve:dashboard": "cd dashboard && go run . --path ..",
    "postinstall": "npx playwright install chromium --with-deps || npx playwright install chromium --with-deps"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "cicerone",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fernández de Valderrama",
  "contributors": [
    "svy04 (https://github.com/svy04)"
  ],
  "homepage": "https://github.com/svy04/cicerone",
  "repository": {
    "type": "git",
    "url": "https://github.com/svy04/cicerone"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^5.3.0",
    "playwright": "1.62.1"
  }
}
